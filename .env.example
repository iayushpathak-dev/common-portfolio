# Get a key at https://aistudio.google.com/apikey and copy this file to .env.local
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the model (default: gemma-4-26b-a4b-it)
# GEMINI_MODEL=gemini-3.8-flash

# Optional analytics: GA4 measurement ID and/or GTM container ID (scripts load only when set)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Canonical site URL for metadata, sitemap and assistant citations (default: https://ayushpathak.co.in)
# NEXT_PUBLIC_SITE_URL=https://ayushpathak.co.in

# ── AI assistant knowledge base (RAG) ──────────────────────────────────────────
# Upstash Vector index: create it with 768 dimensions and the COSINE metric.
# Without these, the assistant answers personal questions from core profile data only.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
# Optional: separate namespace, e.g. for a staging index
# UPSTASH_VECTOR_NAMESPACE=

# Upstash Redis: shared rate limiting and index status. Without it, rate limiting is per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects POST/GET /api/rag/reindex. At least 32 characters, e.g. `openssl rand -hex 32`.
RAG_ADMIN_SECRET=

# Optional tuning (see lib/rag/config.ts)
# RAG_TOP_K=6
# RAG_MIN_SCORE=0.6
# RAG_SCOPE_OVERRIDE_SCORE=0.7
# RAG_MAX_CONTEXT_CHARS=9000
# CHAT_RATE_LIMIT=10
# CHAT_RATE_LIMIT_WINDOW=60
