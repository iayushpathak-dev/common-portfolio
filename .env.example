# Get a key at https://aistudio.google.com/apikey and copy this file to .env.local
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the model (default: gemma-4-26b-a4b-it)
# GEMINI_MODEL=gemini-3.8-flash

# Optional analytics: GA4 measurement ID and/or GTM container ID (scripts load only when set)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Canonical site URL for metadata, sitemap and assistant citations (default: https://ayushpathak.co.in)
# NEXT_PUBLIC_SITE_URL=https://ayushpathak.co.in

# ── AI assistant knowledge base (RAG) ──────────────────────────────────────────
# Upstash Vector index: Dense, embedding model openai/text-embedding-3-small, COSINE metric.
# The index embeds text itself, so no embedding API key is needed.
# To embed with Gemini instead: RAG_EMBEDDING_PROVIDER=gemini and a Custom 768-dimension index.
# RAG_EMBEDDING_PROVIDER=upstash
# Without these, the assistant answers personal questions from core profile data only.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
# Optional: separate namespace, e.g. for a staging index
# UPSTASH_VECTOR_NAMESPACE=

# Upstash Redis: shared rate limiting and index status. Without it, rate limiting is per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects POST/GET /api/rag/reindex. At least 32 characters, e.g. `openssl rand -hex 32`.
RAG_ADMIN_SECRET=

# Optional tuning (see lib/rag/config.ts)
# RAG_TOP_K=6
# RAG_MIN_SCORE=0.6
# RAG_SCOPE_OVERRIDE_SCORE=0.7
# RAG_MAX_CONTEXT_CHARS=9000
# CHAT_RATE_LIMIT=10
# CHAT_RATE_LIMIT_WINDOW=60

# ── Private /findjobs dashboard ────────────────────────────────────────────────
# Login for /findjobs (password: at least 8 characters). Data is stored in Upstash Redis
# (in memory under `next dev`). Changing the password logs out every browser.
# FINDJOBS_USERNAME=
# FINDJOBS_PASSWORD=
# Optional job search (India). Free keys at https://developer.adzuna.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# ── Answer model (optional) ────────────────────────────────────────────────────
# With ANTHROPIC_API_KEY set, Claude answers and Gemini handles only web search.
# Without it, everything uses GEMINI_MODEL as before. GOOGLE_GENERATIVE_AI_API_KEY stays
# required either way (embeddings + web search).
# ANTHROPIC_API_KEY=
# ANSWER_MODEL=claude-haiku-5-5
# SEARCH_MODEL=gemini-3.1-flash-lite

# Answers with this Google model when the main model fails before replying (busy/503, quota).
# Set to empty to turn it off.
# FALLBACK_MODEL=   (default: the Gemma model when Claude answers, else gemini-3.1-flash-lite)
# SEARCH_MODEL=     (default: the Gemma model; gemini-* models need billing on the Google project)
